# Application
APP_NAME=TestShop
APP_ENV=local
APP_DEBUG=true
APP_URL=http://test-shop.loc

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=test_shop
DB_USERNAME=test_user
DB_PASSWORD=test_password

# Redis (если используете)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (для тестов)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=test@test-shop.loc
MAIL_FROM_NAME="${APP_NAME}"

# Webhook (для тестов)
WEBHOOK_URL=http://test-shop.loc/api/webhook